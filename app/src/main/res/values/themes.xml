<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.PeakForm" parent="Theme.Material3.DayNight">
        <!-- Customize Material 3 colors -->
        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="colorOnPrimary">@color/md_theme_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_dark_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_dark_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_dark_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_dark_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_dark_error</item>
        <item name="colorOnError">@color/md_theme_dark_onError</item>
        <item name="colorErrorContainer">@color/md_theme_dark_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_dark_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_dark_background</item>
        <item name="colorOnBackground">@color/md_theme_dark_onBackground</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_dark_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_dark_outline</item>
        <item name="colorSurfaceInverse">@color/md_theme_dark_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_dark_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_dark_inversePrimary</item>

        <!-- Typography -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.PeakForm.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.PeakForm.DisplayMedium</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.PeakForm.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.PeakForm.HeadlineMedium</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.PeakForm.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.PeakForm.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.PeakForm.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.PeakForm.BodyMedium</item>
    </style>

    <style name="Theme.PeakForm" parent="Base.Theme.PeakForm" />

    <style name="Theme.PeakForm.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Typography Styles -->
    <style name="TextAppearance.PeakForm.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/noto_sans_display</item>
        <item name="android:fontFamily">@font/noto_sans_display</item>
    </style>

    <style name="TextAppearance.PeakForm.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/noto_sans_display</item>
        <item name="android:fontFamily">@font/noto_sans_display</item>
    </style>

    <style name="TextAppearance.PeakForm.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/noto_sans_display</item>
        <item name="android:fontFamily">@font/noto_sans_display</item>
    </style>

    <style name="TextAppearance.PeakForm.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/noto_sans_display</item>
        <item name="android:fontFamily">@font/noto_sans_display</item>
    </style>

    <style name="TextAppearance.PeakForm.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>

    <style name="TextAppearance.PeakForm.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>

    <style name="TextAppearance.PeakForm.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>

    <style name="TextAppearance.PeakForm.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>
</resources>