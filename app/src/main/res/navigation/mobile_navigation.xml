<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/homePageFragment">

    <fragment
        android:id="@+id/homePageFragment"
        android:name="com.example.myapp.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home"/>

    <fragment
        android:id="@+id/navigation_workouts"
        android:name="com.example.myapp.WorkoutFragment"
        android:label="@string/nav_workouts"
        tools:layout="@layout/fragment_workout" />

    <fragment
        android:id="@+id/navigation_nutrition"
        android:name="com.example.myapp.NutritionFragment"
        android:label="@string/nav_nutrition"
        tools:layout="@layout/fragment_nutrition" />
</navigation>