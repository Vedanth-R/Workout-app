<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/item_trophy.xml -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top row: icon + status chip (LOCKED/UNLOCKED) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivTrophyIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/achievement_badge"
                app:tint="?attr/colorOnSurfaceVariant"
                tools:src="@drawable/ic_lock" />

            <TextView
                android:id="@+id/tvTrophyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="12sp"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="LOCKED" /><!--                android:background="@drawable/bg_status_chip"  &lt;!&ndash; optional rounded bg (create later) &ndash;&gt;-->
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvTrophyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="10-Day Streak" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvTrophyDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Work out 10 days in a row." />

        <!-- Optional Progress (set GONE if already unlocked or not progressive) -->
        <LinearLayout
            android:id="@+id/layoutProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbTrophyProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:progress="40"
                android:max="100" />

            <TextView
                android:id="@+id/tvTrophyProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="4 / 10" />
        </LinearLayout>

        <!-- Subtle lock overlay icon (optional, starts GONE) -->
        <ImageView
            android:id="@+id/ivLockOverlay"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="10dp"
            android:src="@android:drawable/ic_lock_lock"
            android:visibility="gone"
            android:contentDescription="@string/locked"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
