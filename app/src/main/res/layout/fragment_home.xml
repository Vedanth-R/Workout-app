                    android:orientation="horizontal"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_personal_record" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>-->

        <!-- Quick Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickWorkout"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:text="@string/quick_start_workout"
                android:textColor="@color/white"
                android:backgroundTint="@color/vibrantAccent"
                app:icon="@drawable/ic_workouts"
                app:iconTint="@color/white"
                app:cornerRadius="16dp"
                style="@style/Widget.Material3.Button.UnelevatedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogMeal"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/log_meal"
                android:textColor="@color/vibrantAccent"
                app:icon="@drawable/ic_nutrition"
                app:iconTint="@color/vibrantAccent"
                app:cornerRadius="16dp"
                app:strokeColor="@color/vibrantAccent"
                app:strokeWidth="2dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>