<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundDark"
    android:padding="20dp"
    android:fillViewport="true"
    android:clipToPadding="false"
    tools:context=".TimerFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/trainRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- keep ALL your existing children here, unchanged except for the edits noted in this answer -->
        <!-- Header -->
        <!--<LinearLayout
            android:id="@+id/llHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">-->

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Train"
            android:layout_weight="1"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

            <!--&lt;!&ndash; One-time daily log button &ndash;&gt;
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogWorkoutOneTime"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/log_workout"
                android:contentDescription="Log workout for streak"
                android:textColor="@color/vibrantAccent"
                app:cornerRadius="12dp"
                app:strokeColor="@color/vibrantAccent"
                app:strokeWidth="2dp"
                style="?attr/materialButtonOutlinedStyle"
                tools:enabled="true" />-->

<!--        </LinearLayout>-->

        <!-- Timer Display Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/timerCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/backgroundLight"
            app:strokeWidth="0dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp"
                android:gravity="center">

                <!-- Big workout timer -->
                <TextView
                    android:id="@+id/tvWorkoutTimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:ellipsize="none"
                    android:gravity="center"
                    android:text="00:00:00"
                    android:textSize="56sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="monospace"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="28sp"
                    app:autoSizeMaxTextSize="64sp"
                    app:autoSizeStepGranularity="2sp" />

                <!-- Sets completed counter -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/tvSetsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sets"
                        android:textSize="16sp"
                        android:textColor="@color/hintColor" />

                    <TextView
                        android:id="@+id/tvSetsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="@color/vibrantAccent"
                        android:layout_marginStart="12dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primary controls row -->
        <LinearLayout
            android:id="@+id/controlsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/timerCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Start"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/vibrantAccent"
                app:cornerRadius="16dp"
                android:contentDescription="Start workout"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPauseResume"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Pause"
                android:textSize="16sp"
                android:textColor="@color/hintColor"
                android:enabled="false"
                app:cornerRadius="16dp"
                app:strokeColor="@color/hintColor"
                app:strokeWidth="2dp"
                style="?attr/materialButtonOutlinedStyle"
                android:contentDescription="Pause or resume workout"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnd"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="End"
                android:textSize="16sp"
                android:textColor="@color/hintColor"
                android:enabled="false"
                app:cornerRadius="16dp"
                app:strokeColor="@color/hintColor"
                app:strokeWidth="2dp"
                style="?attr/materialButtonOutlinedStyle"
                android:contentDescription="End workout"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"/>
        </LinearLayout>

        <!-- Actions row: complete set and start rest -->
        <LinearLayout
            android:id="@+id/actionsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/controlsRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCompleteSet"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Complete Set"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/hintColor"
                android:enabled="false"
                app:cornerRadius="14dp"
                android:contentDescription="Mark set complete and start rest"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartRest"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Rest"
                android:textSize="15sp"
                android:textColor="@color/hintColor"
                android:enabled="false"
                app:cornerRadius="14dp"
                app:strokeColor="@color/hintColor"
                app:strokeWidth="2dp"
                style="?attr/materialButtonOutlinedStyle"
                android:contentDescription="Start rest timer"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"/>
        </LinearLayout>

        <!-- Rest panel -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/restPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/backgroundLight"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/actionsRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvRestLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rest"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/white"/>

                <TextView
                    android:id="@+id/tvRestTimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="00:30"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/teal_200"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestAdd15"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="52dp"
                        android:text="+15s"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/teal_200"
                        app:cornerRadius="14dp" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestSkip"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="52dp"
                        android:text="Skip"
                        android:textColor="@color/teal_200"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/teal_200"
                        app:strokeWidth="2dp"
                        style="?attr/materialButtonOutlinedStyle" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- End summary panel (hidden until End) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/summaryPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/backgroundLight"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            app:layout_goneMarginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/restPanel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSummaryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Workout Summary"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/white"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvSummaryTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Time: 00:00:00"
                        android:textSize="16sp"
                        android:textColor="@color/textColor"/>

                    <TextView
                        android:id="@+id/tvSummarySets"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sets: 0"
                        android:textSize="16sp"
                        android:textColor="@color/textColor"
                        android:gravity="end"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSummaryDone"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Save &amp; Exit"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/vibrantAccent"
                    app:cornerRadius="14dp"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
